# Compila Angular con la URL real del sitio y lo sirve con Caddy (HTTPS automatico).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install
COPY . .
ARG SITE_URL
ARG API_BASE_URL
RUN sed -i "s#msalRedirectUri: '[^']*'#msalRedirectUri: '${SITE_URL}'#; s#apiBaseUrl: '[^']*'#apiBaseUrl: '${API_BASE_URL}'#" src/environments/environment.ts
RUN npx ng build
RUN mkdir /out && if [ -d dist/pedidos360-frontend/browser ]; then cp -r dist/pedidos360-frontend/browser/. /out; else cp -r dist/pedidos360-frontend/. /out; fi

FROM caddy:2-alpine
COPY --from=build /out /srv/frontend